config {
    type: "table",
    schema: "Lookups",
    dependencies: [
    "assert_ext_answeroption_not_empty",
    ],
    bigquery: {
        partitionBy: "DATE(created_date)",
      clusterBy: ["question_id"]
  }
}

/*
pre_operations {
  CALL `rifd-datascience-sa.Staging_Tables.update_watermark_with_retry`(
      ['onboarding_schema:answeroption'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.Staging_Tables.update_watermark_with_retry`(
      ['onboarding_schema:answeroption'],
      TRUE
    )
}
*/


SELECT
    id,
    questionid as question_id,
    optiontext as option_text,
    optiontextar as option_textar,
    optionvalue as option_value,
    displayorder as display_order,
    isactive as is_active,
    createdby as created_by,
    lastmodifiedby as lastmodified_by,
    CAST(createddate AS DATETIME) as created_date,
    CAST(lastmodifieddate AS DATETIME) as lastmodified_date,
    CURRENT_DATETIME() AS etl_timestamp
FROM ${ref("ext_answeroption")}