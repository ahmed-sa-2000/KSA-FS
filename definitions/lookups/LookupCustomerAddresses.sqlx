config {
    type: "table",
    schema: "Lookups",
    dependencies: [
      "assert_ext_CustomerAddresses_not_empty",
    ],
    bigquery: {
      clusterBy: ["id", "customer_id" , "city_id" , "region_id"]
    }
}

/*
pre_operations {
  CALL `rifd-datascience-sa.Staging_Tables.update_watermark_with_retry`(
      ['onboarding_schema:customeraddresses'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.Staging_Tables.update_watermark_with_retry`(
      ['onboarding_schema:customeraddresses'],
      TRUE
    )
}
*/

SELECT
  id,
  customerid AS customer_id,
  
  regionid AS region_id,
  regionname AS regionname_ar,
  regionnamel2 AS regionname_en,

  cityid AS city_id,
  city AS city_ar,
  cityl2 AS city_en,


  districtid AS district_id,
  district AS district_ar,
  districtl2 AS district_en,

  streetname AS streetname_ar,
  streetl2 AS streetname_en,

  buildingnumber AS building_number,
  additionalnumber AS additional_number,
  postcode AS post_code,
  shortaddress AS short_address,
  locationcoordinates AS location_coordinates,
  isprimaryaddress AS isprimary_address,
  isactive AS is_active,
  createdby AS created_by,
  CAST(createddate AS DATETIME) AS created_date,
  lastmodifiedby AS lastmodified_by,
  CAST(lastmodifieddate AS DATETIME) AS lastmodified_date, 
  CURRENT_DATETIME() AS etl_timestamp

FROM ${ref("ext_CustomerAddresses")}