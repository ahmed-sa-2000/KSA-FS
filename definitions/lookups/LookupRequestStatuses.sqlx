config {
    type: "table",
    dependencies: [
      "assert_ext_requeststatuses_not_empty",
    ],
    bigquery: {
      clusterBy: ["id", "name"]
    }
}

pre_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['merchant_schema:requeststatuses'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['merchant_schema:requeststatuses'],
      TRUE
    )
}

select 
  id,
  name,
  description,
  active,
  CURRENT_DATETIME() as etl_timestamp
from ${ref('ext_requeststatuses')}