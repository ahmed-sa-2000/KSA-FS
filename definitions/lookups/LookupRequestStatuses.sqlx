config {
    type: "table",

    dependencies: [
    "assert_ext_RequestStatuses_not_empty",
  ]
}

pre_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['RequestStatuses'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['RequestStatuses'],
      TRUE
    )
}

select 
  id as rs_request_statuesid,
  name as rs_statusname,
  description as rs_description,
  active as rs_active ,
  CURRENT_DATETIME() as etl_timestamp
from ${ref('ext_RequestStatuses')}