config {
    type: "table",

    dependencies: [
    "assert_ext_MerchantApplications_not_empty",
  ]
  ,
    bigquery: {
        partitionBy:"Date(mr_createddate)"
    }
}

pre_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['MerchantApplicationStatus'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['MerchantApplicationStatus'],
      TRUE
    )
}

select 
  CURRENT_DATETIME() as etl_timestamp
from ${ref('ext_RequestStatuses')}