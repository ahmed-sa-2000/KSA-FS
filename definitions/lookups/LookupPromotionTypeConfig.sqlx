config {
    type: "table",
    dependencies: [
        "assert_ext_promotiontypeconfigs_not_empty",
        
    ],
    bigquery: {
      clusterBy: ["promotiontypeid", "attribute_name"]
    }
}

pre_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['promotion_schema:promotiontypeconfigs'],
      FALSE )
}

post_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['promotion_schema:promotiontypeconfigs'],
      TRUE )
}

SELECT
  id,
  promotiontypeid,
  attributename AS attribute_name,
  attributevaluetype AS attribute_valuetype,
  required,
  displayname AS display_name,
  createdby AS created_by,
  lastmodifiedby AS lastmodified_by,
  CAST(CreatedDate AS DATETIME) AS created_date,
  CAST(lastmodifieddate AS DATETIME) AS lastmodified_date,
  CURRENT_DATETIME() AS etl_timestamp
FROM
  ${ref('ext_promotiontypeconfigs')}

