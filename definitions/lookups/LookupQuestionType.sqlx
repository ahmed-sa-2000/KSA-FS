config {
    type: "table",
    schema: "Lookups",
    dependencies: [
        "assert_ext_questiontype_not_empty",
    ],
    bigquery: {
      clusterBy: ["id", "type_name"]
    }
}

pre_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['onboarding_schema:questiontype'],
      FALSE )
}

post_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['onboarding_schema:questiontype'],
      TRUE )
}

SELECT
  id,
  typename AS type_name,
  typenamear AS type_namear,
  isactive AS is_active ,
  createdBy AS created_by,
  lastmodifiedby AS modified_by,
  CAST(CreatedDate AS DATETIME) AS created_date,
  CAST(LastModifiedDate AS DATETIME) AS lastmodified_date,
  CURRENT_DATETIME() AS etl_timestamp
FROM
  ${ref('ext_questiontype')}