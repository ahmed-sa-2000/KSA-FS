config {
    type: "table",

    dependencies: [
        "assert_ext_PromotionsTypesLookups_not_empty",
    ]
}

SELECT
  id , 
  name ,
  createdBy AS created_by,
  lastmodifiedby AS modified_by,
  CreatedDate AS created_date,
  LastModifiedDate lastmodified_date,
  CURRENT_DATETIME() AS etl_timestamp
FROM
  ${ref('ext_PromotionsTypesLookups')}


pre_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['PromotionsTypesLookups'],
      FALSE )
}

post_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['PromotionsTypesLookups'],
      TRUE )
}
