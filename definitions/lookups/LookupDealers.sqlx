config {
    type: "incremental",
    uniqueKey: ["d_dealerid"],
    onSchemaChange: "EXTEND",
    bigquery: {
        partitionBy: "DATE(created_date)",
        clusterBy: ["d_dealerid", "d_name"]
    }
}

pre_operations {
    -- Capture the target checkpoint before processing
    DECLARE previous_rowversion STRING DEFAULT (
        ${when(
            incremental(),
            `SELECT COALESCE(MAX(rowversion), '')
             FROM ${self()}`,
            `SELECT CAST('' AS STRING)`
        )}
    );

    ---
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['merchant_schema:dealers'],
        FALSE
    );
}

post_operations {
    -- Delete only dealers whose latest event in the new delta is a delete
    ${when(incremental(), `
        DELETE FROM ${self()} AS T
        WHERE EXISTS (
            SELECT 1
            FROM (
                SELECT
                    id,
                    datastream_metadata.change_type AS change_type,
                    datastream_metadata.change_sequence_number
                        AS change_sequence_number
                FROM ${ref("int_dealers")}
                WHERE datastream_metadata.change_sequence_number
                    > previous_rowversion
                QUALIFY ROW_NUMBER() OVER (
                    PARTITION BY id
                    ORDER BY
                        datastream_metadata.change_sequence_number DESC
                ) = 1
            ) AS S
            WHERE S.id = T.d_dealerid
              AND S.change_type IN ('DELETE', 'UPDATE-DELETE')
              AND S.change_sequence_number > T.rowversion
        );
    `)}

    ---
    -- Mark watermark processing as completed
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['merchant_schema:dealers'],
        TRUE
    );
}

-- Main incremental model query
WITH ranked AS (
    SELECT
        *,
        datastream_metadata.change_type AS change_type,
        datastream_metadata.change_sequence_number
            AS change_sequence_number,
        ROW_NUMBER() OVER (
            PARTITION BY id
            ORDER BY
                datastream_metadata.change_sequence_number DESC
        ) AS rn
    FROM ${ref("int_dealers")}
    ${when(incremental(), `
        WHERE datastream_metadata.change_sequence_number
            > previous_rowversion
    `)}
)

SELECT
    id AS d_dealerid,
    Name AS d_name,
    IsActive AS d_active,
    ReturnPolicy AS d_returnpolicy,
    CAST(InterestRate AS FLOAT64) AS d_interestrate,
    Refundable AS d_refundable,
    Phone AS d_phone,
    Visible AS d_visible,
    change_sequence_number AS rowversion,
    createdby AS created_by,
    lastmodifiedby AS modified_by,
    createddate AS created_date,
    lastmodifieddate AS lastmodified_date,
    CURRENT_DATETIME() AS etl_timestamp
FROM ranked
WHERE rn = 1
  AND change_type IN ('INSERT', 'UPDATE-INSERT')