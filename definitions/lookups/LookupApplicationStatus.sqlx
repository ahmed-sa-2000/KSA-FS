config {
    type: "table",
    dependencies: [
        "assert_ext_applicationstatuslookups_not_empty",
    ],
    bigquery: {
      clusterBy: ["code", "name"]
    }
}

/*
pre_operations {
  CALL
    `rifd-datascience-sa.Staging_Tables.update_watermark_with_retry`( ['onboarding_schema:applicationstatuslookups'],
      FALSE )
}

post_operations {
  CALL
    `rifd-datascience-sa.Staging_Tables.update_watermark_with_retry`( ['onboarding_schema:applicationstatuslookups'],
      TRUE )
}
*/

SELECT
  code,
  name,
  isactive AS is_active,
  CURRENT_DATETIME() AS etl_timestamp
FROM
  ${ref('ext_applicationstatuslookups')}


