config {
    type: "table",

    dependencies: [
        "assert_ext_DepositsStatusLookups_not_empty",
    ]
}

SELECT
  id , 
  name AS status_name,
  createdBy AS created_by,
  lastmodifiedby AS modified_by,
  CreatedDate AS created_date,
  LastModifiedDate lastmodified_date,
  CURRENT_DATETIME() AS etl_timestamp
FROM
  ${ref('ext_DepositsStatusLookups')}
  /*
  ${when(incremental(),
  `
  WHERE COALESCE(lastmodified_date, created_date) >= (select MAX(GREATEST(created_date, lastmodified_date)) from ${self()})
  `
  )}
  */

pre_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['DepositsStatusLookups'],
      FALSE )
}

post_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['DepositsStatusLookups'],
      TRUE )
}
