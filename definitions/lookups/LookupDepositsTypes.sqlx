config {
    type: "table",
    schema: "Lookups",
    dependencies: [
        "assert_ext_DepositsTypesLookups_not_empty",
    ],
    bigquery: {
      clusterBy: ["id", "name"]
    }
}

pre_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['depositstypeslookups'],
      FALSE )
}

post_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['depositstypeslookups'],
      TRUE )
}


SELECT
  id,
  name,
  createdBy AS created_by,
  lastmodifiedby AS modified_by,
  CAST(CreatedDate AS DATETIME) AS created_date,
  CAST(LastModifiedDate AS DATETIME) AS lastmodified_date,
  CURRENT_DATETIME() AS etl_timestamp
FROM
  ${ref('ext_DepositsTypesLookups')}


