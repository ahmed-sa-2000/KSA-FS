config {
    type: "table",
    dependencies: [
        'assert_ext_MerchantRoles_not_empty',
        'assert_DimMerchantUsers_not_empty'
    ],
    bigquery: {
        partitionBy: "DATE(mr_createddate)",
        clusterBy: ["mr_merchantid", "mr_storeid", "mr_roleid"]
    }
    // uniqueKey: ["mr_id"]
}

pre_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['merchantroles'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['merchantroles'],
      TRUE
    )
}

WITH merchant_roles_stg AS (
    select 
        id as mr_id,
        MerchantId as mr_merchantid,
        RoleId as mr_roleid,
        IsActive as mr_isactive,
        CreatedBy as mr_createdby,
        LastModifiedBy as mr_modifiedby,
        CAST(CreatedDate AS DATETIME) as mr_createddate,
        CAST(LastModifiedDate AS DATETIME) as mr_modifieddate,
        COALESCE(CAST(LastModifiedDate AS DATETIME), CAST(CreatedDate AS DATETIME)) as row_timestamp
    FROM ${ref('ext_MerchantRoles')}
),
merchants_stg AS (
    SELECT mu_merchantid, ds_storeid
    FROM ${ref('DimMerchantUsers')}
)
SELECT 
    mrs.mr_id,
    mrs.mr_merchantid,
    ms.ds_storeid AS mr_storeid,
    mrs.mr_roleid,
    mrs.mr_isactive,
    mrs.mr_createdby,
    mrs.mr_modifiedby,
    mrs.mr_createddate,
    mrs.mr_modifieddate,
    mrs.row_timestamp,
    CURRENT_DATETIME() AS etl_timestamp
FROM merchant_roles_stg mrs
    LEFT JOIN merchants_stg ms ON ms.mu_merchantid = mrs.mr_merchantid

/*
${when(incremental(), 
  `
  WHERE COALESCE(mrs.mr_modifieddate, mrs.mr_createddate) >= (select MAX(row_timestamp) from ${self()})
  `
)}
*/