config {
    type: "incremental",
    uniqueKey: ["cad_id"],
    onSchemaChange: "EXTEND",
    bigquery: {
        partitionBy: "DATE(cad_createddate)",
        clusterBy: [
            "cad_id",
            "cad_customerid",
            "cad_questionid"
        ]
    }
}

pre_operations {
    -- Capture the target checkpoint before processing
    DECLARE previous_rowversion STRING DEFAULT (
        ${when(
            incremental(),
            `SELECT COALESCE(MAX(rowversion), '')
             FROM ${self()}`,
            `SELECT CAST('' AS STRING)`
        )}
    );

    -- Mark watermark processing as started
    ---
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['onboarding_schema:customeranswerdetails'],
        FALSE
    );
}

post_operations {
    -- Delete records whose latest event in the delta is a delete
    ${when(incremental(), `
        DELETE FROM ${self()} AS T
        WHERE EXISTS (
            SELECT 1
            FROM (
                SELECT
                    id,
                    datastream_metadata.change_type AS change_type,
                    datastream_metadata.change_sequence_number
                        AS change_sequence_number
                FROM ${ref("int_customeranswerdetails")}
                WHERE datastream_metadata.change_sequence_number
                    > previous_rowversion
                QUALIFY ROW_NUMBER() OVER (
                    PARTITION BY id
                    ORDER BY
                        datastream_metadata.change_sequence_number DESC
                ) = 1
            ) AS S
            WHERE S.id = T.cad_id
              AND S.change_type IN ('DELETE', 'UPDATE-DELETE')
              AND S.change_sequence_number > T.rowversion
        );
    `)}

    ---
    -- Mark watermark processing as completed
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['onboarding_schema:customeranswerdetails'],
        TRUE
    );
}

WITH ranked AS (
    SELECT
        *,
        datastream_metadata.change_type AS change_type,
        datastream_metadata.change_sequence_number
            AS change_sequence_number,
        ROW_NUMBER() OVER (
            PARTITION BY id
            ORDER BY
                datastream_metadata.change_sequence_number DESC
        ) AS rn
    FROM ${ref("int_customeranswerdetails")}
    ${when(incremental(), `
        WHERE datastream_metadata.change_sequence_number
            > previous_rowversion
    `)}
)

SELECT
    id AS cad_id,
    customerid AS cad_customerid,
    questionid AS cad_questionid,
    answervalue AS cad_answervalue,
    isactive AS cad_isactive,
    createdby AS cad_createdby,
    lastmodifiedby AS cad_lastmodifiedby,
    CAST(createddate AS DATETIME) AS cad_createddate,
    CAST(lastmodifieddate AS DATETIME) AS cad_lastmodifieddate,
    change_sequence_number AS rowversion,
    CURRENT_DATETIME() AS etl_timestamp
FROM ranked
WHERE rn = 1
