config {
    type: "incremental",
    uniqueKey: ["deposit_id"],
    onSchemaChange: "EXTEND",
    dependencies: [
        "assert_LookupDepositsTypes_not_empty",
        "assert_LookupDepositsStatus_not_empty",
        "assert_FactInstallmentDetails_not_empty"
    ],
    bigquery: {
        partitionBy: "DATE(createddate)",
        clusterBy: ["deposit_id", "installmentdetails_id", "installment_id", "customer_id"]
    }
}

pre_operations {
    -- Capture the target checkpoint before processing
    DECLARE previous_rowversion STRING DEFAULT (
        ${when(
            incremental(),
            `SELECT COALESCE(MAX(rowversion), '')
             FROM ${self()}`,
            `SELECT CAST('' AS STRING)`
        )}
    );

    ---
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['loan_schema:deposits'],
        FALSE
    );
}

post_operations {
    -- Delete only deposits whose latest event in the new delta is a delete
    ${when(incremental(), `
        DELETE FROM ${self()} AS T
        WHERE EXISTS (
            SELECT 1
            FROM (
                SELECT
                    id,
                    datastream_metadata.change_type AS change_type,
                    datastream_metadata.change_sequence_number
                        AS change_sequence_number
                FROM ${ref("int_deposits")}
                WHERE datastream_metadata.change_sequence_number
                    > previous_rowversion
                QUALIFY ROW_NUMBER() OVER (
                    PARTITION BY id
                    ORDER BY
                        datastream_metadata.change_sequence_number DESC
                ) = 1
            ) AS S
            WHERE S.id = T.deposit_id
              AND S.change_type IN ('DELETE', 'UPDATE-DELETE')
              AND S.change_sequence_number > T.rowversion
        );
    `)}

    ---
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['loan_schema:deposits'],
        TRUE
    );
}

WITH ranked AS (
    SELECT
        *,
        datastream_metadata.change_type AS change_type,
        datastream_metadata.change_sequence_number
            AS change_sequence_number,
        ROW_NUMBER() OVER (
            PARTITION BY id
            ORDER BY
                datastream_metadata.change_sequence_number DESC
        ) AS rn
    FROM ${ref("int_deposits")}
    ${when(incremental(), `
        WHERE datastream_metadata.change_sequence_number
            > previous_rowversion
    `)}
)

SELECT
    d.id AS deposit_id,
    d.installmentdetailsid AS installmentdetails_id,
    ids.purchaseorder_id,
    d.installmentid AS installment_id,
    ids.customer_id,
    ids.merchant_id,
    d.deposittype AS deposit_type,
    t.name AS deposittype_name,
    d.status AS status,
    s.name AS status_name,
    d.paymentmethod AS paymentmethod,
    d.depositenumber AS deposite_number,
    d.month AS month,
    d.adminfees AS adminfees,
    d.totalfees AS totalfees,
    CAST(d.amount AS BIGNUMERIC) AS amount,
    d.principalamount AS principal_amount,
    d.monthlypaid AS monthly_paid,
    d.interestamount AS interest_amount,
    d.cumulativeinterest AS cumulative_interest,
    d.cumulativeprincipal AS cumulative_principal,
    d.remainingbalance AS remaining_balance,
    d.remainingtotaldue AS remaining_totaldue,
    d.totalpaidamount AS total_paidamount,
    CAST(d.deposit_gs_interest AS BIGNUMERIC) AS deposit_gsinterest,
    CAST(d.deposit_gs_totalremaining AS BIGNUMERIC) AS deposit_gstotalremaining,
    d.deposit_gs_interestrate AS deposit_gsinterestrate,
    d.isrungs AS isrungs,
    d.deposit_securitization AS deposit_securitization,
    CAST(d.collectdate AS DATETIME) AS collect_date,
    d.collectedby AS collected_by,
    CAST(d.duedate AS DATETIME) AS due_date,
    d.xirrcashflow AS xirrcashflow,
    SAFE_CAST(d.xirrdate AS DATETIME) AS xirrdate,
    d.createdby AS createdby,
    CAST(d.createddate AS DATETIME) AS createddate,
    d.lastmodifiedby AS modifiedby,
    CAST(d.lastmodifieddate AS DATETIME) AS lastmodifieddate,
    COALESCE(CAST(d.lastmodifieddate AS DATETIME),
             CAST(d.createddate AS DATETIME)) AS row_timestamp,
    d.change_sequence_number AS rowversion,
    CURRENT_DATETIME() AS etl_timestamp
FROM ranked d
LEFT JOIN ${ref("LookupDepositsTypes")} t
    ON t.id = d.deposittype
LEFT JOIN ${ref("LookupDepositsStatus")} s
    ON s.id = d.status
LEFT JOIN ${ref("FactInstallmentDetails")} ids
    ON ids.installmentdetails_id = d.installmentdetailsid
WHERE d.rn = 1
  AND d.change_type IN ('INSERT', 'UPDATE-INSERT')