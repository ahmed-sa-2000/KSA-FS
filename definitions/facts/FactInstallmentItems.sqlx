config {
    type: "incremental",
    uniqueKey: ["installmentitem_id"],
    onSchemaChange: "EXTEND",
    dependencies: [
        "assert_LookupInstallmentItemStatus_not_empty",
        "assert_FactInstallmentDetails_not_empty"
    ],
    bigquery: {
        partitionBy: "DATE(createddate)",
        clusterBy: ["installmentitem_id", "installmentdetails_id", "installment_id", "customer_id"]
    }
}

pre_operations {
    -- Capture the target checkpoint before processing
    DECLARE previous_rowversion STRING DEFAULT (
        ${when(
            incremental(),
            `SELECT COALESCE(MAX(rowversion), '')
             FROM ${self()}`,
            `SELECT CAST('' AS STRING)`
        )}
    );

    ---
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['loan_schema:installmentitems'],
        FALSE
    );
}

post_operations {
    -- Delete only items whose latest event in the new delta is a delete
    ${when(incremental(), `
        DELETE FROM ${self()} AS T
        WHERE EXISTS (
            SELECT 1
            FROM (
                SELECT
                    id,
                    datastream_metadata.change_type AS change_type,
                    datastream_metadata.change_sequence_number
                        AS change_sequence_number
                FROM ${ref("int_installmentitems")}
                WHERE datastream_metadata.change_sequence_number
                    > previous_rowversion
                QUALIFY ROW_NUMBER() OVER (
                    PARTITION BY id
                    ORDER BY
                        datastream_metadata.change_sequence_number DESC
                ) = 1
            ) AS S
            WHERE S.id = T.installmentitem_id
              AND S.change_type IN ('DELETE', 'UPDATE-DELETE')
              AND S.change_sequence_number > T.rowversion
        );
    `)}

    ---
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['loan_schema:installmentitems'],
        TRUE
    );
}

WITH ranked AS (
    SELECT
        *,
        datastream_metadata.change_type AS change_type,
        datastream_metadata.change_sequence_number
            AS change_sequence_number,
        ROW_NUMBER() OVER (
            PARTITION BY id
            ORDER BY
                datastream_metadata.change_sequence_number DESC
        ) AS rn
    FROM ${ref("int_installmentitems")}
    ${when(incremental(), `
        WHERE datastream_metadata.change_sequence_number
            > previous_rowversion
    `)}
)

SELECT
    i.id AS installmentitem_id,
    i.installmentdetailsid AS installmentdetails_id,
    fid.purchaseorder_id,
    fid.installment_id,
    fid.customer_id,
    fid.merchant_id,
    fid.branch_id,
    i.itemcode AS itemcode,
    i.itemname AS itemname,
    CAST(i.price AS BIGNUMERIC) AS price,
    i.quantity AS quantity,
    i.refundedquantity AS refunded_quantity,
    i.status AS status,
    l.name AS status_name,
    i.createdby AS createdby,
    CAST(i.createddate AS DATETIME) AS createddate,
    i.lastmodifiedby AS modifiedby,
    CAST(i.lastmodifieddate AS DATETIME) AS lastmodifieddate,
    COALESCE(CAST(i.lastmodifieddate AS DATETIME),
             CAST(i.createddate AS DATETIME)) AS row_timestamp,
    i.change_sequence_number AS rowversion,
    CURRENT_DATETIME() AS etl_timestamp
FROM ranked i
LEFT JOIN ${ref("LookupInstallmentItemStatus")} l
    ON l.id = i.status
LEFT JOIN ${ref("FactInstallmentDetails")} fid
    ON fid.installmentdetails_id = i.installmentdetailsid
WHERE i.rn = 1
  AND i.change_type IN ('INSERT', 'UPDATE-INSERT')