  `WHERE COALESCE(CAST(i.lastmodifieddate AS DATETIME), CAST(i.createddate AS DATETIME)) >=
        (SELECT MAX(COALESCE(ii_lastmodified_date, ii_created_date)) FROM ${self()})`
)}
*/