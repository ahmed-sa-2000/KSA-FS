config {
    type: "table",
    dependencies: [
        'assert_ext_InstallmentDetails_not_empty',
        'assert_LookupInstallmentDetailsStatus_not_empty'
    ],
    bigquery: {
        clusterBy: ["installmentdetails_id", "installment_id"]
    }    

    // uniqueKey: ["id"]
}


pre_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['installmentdetails'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['installmentdetails'],
      TRUE
    )
}

SELECT
    d.id AS installmentdetails_id,
    d.installmentid AS installment_id,
    d.purchaseorderid AS purchaseorder_id,
    d.customerid AS customer_id,
    d.promoid AS promo_id,
    d.merchantid AS merchant_id,
    d.branchid AS branch_id,
    d.sourceid AS source_id,
    d.status AS status_id,
    l.name AS status_name,
    d.months AS tenor_months,
    CAST(d.adminfees AS BIGNUMERIC) AS adminfees,
    CAST(d.downpayment AS BIGNUMERIC) AS downpayment,
    CAST(d.interestrate AS FLOAT64) AS interestrate,
    CAST(d.installmentamount AS BIGNUMERIC) AS installmentamount,
    CAST(d.monthlypaid AS BIGNUMERIC) AS monthlypaid,
    CAST(d.totalamount AS BIGNUMERIC) AS totalamount,
    d.createdby AS createdby,
    CAST(d.createddate AS DATETIME) AS createddate,
    d.lastmodifiedby AS modifiedby,
    CAST(d.lastmodifieddate AS DATETIME) AS lastmodifieddate,
    COALESCE(CAST(d.lastmodifieddate AS DATETIME), CAST(d.createddate AS DATETIME)) as row_timestamp,
    CURRENT_DATETIME() AS etl_timestamp
FROM ${ref('ext_InstallmentDetails')} d
    LEFT JOIN ${ref('LookupInstallmentDetailsStatus')} l
        ON l.id = d.status
 
/*
${when(incremental(),
  `WHERE COALESCE(CAST(d.lastmodifieddate AS DATETIME), CAST(d.createddate AS DATETIME)) >=
        (SELECT MAX(COALESCE(ind_lastmodifieddate, ind_createddate)) FROM ${self()})`
)}
*/