config {
    type: "incremental",
    uniqueKey: ["installmentdetails_id"],
    onSchemaChange: "EXTEND",
    dependencies: [
        "assert_LookupInstallmentDetailsStatus_not_empty"
    ],
    bigquery: {
        partitionBy: "DATE(createddate)",
        clusterBy: ["installmentdetails_id", "installment_id"]
    }
}

pre_operations {
    -- Capture the target checkpoint before processing
    DECLARE previous_rowversion STRING DEFAULT (
        ${when(
            incremental(),
            `SELECT COALESCE(MAX(rowversion), '')
             FROM ${self()}`,
            `SELECT CAST('' AS STRING)`
        )}
    );

    ---
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['loan_schema:installmentdetails'],
        FALSE
    );
}

post_operations {
    -- Delete only rows whose latest event in the new delta is a delete
    ${when(incremental(), `
        DELETE FROM ${self()} AS T
        WHERE EXISTS (
            SELECT 1
            FROM (
                SELECT
                    id,
                    datastream_metadata.change_type AS change_type,
                    datastream_metadata.change_sequence_number
                        AS change_sequence_number
                FROM ${ref("int_installmentdetails")}
                WHERE datastream_metadata.change_sequence_number
                    > previous_rowversion
                QUALIFY ROW_NUMBER() OVER (
                    PARTITION BY id
                    ORDER BY
                        datastream_metadata.change_sequence_number DESC
                ) = 1
            ) AS S
            WHERE S.id = T.installmentdetails_id
              AND S.change_type IN ('DELETE', 'UPDATE-DELETE')
              AND S.change_sequence_number > T.rowversion
        );
    `)}

    ---
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['loan_schema:installmentdetails'],
        TRUE
    );
}

WITH ranked AS (
    SELECT
        *,
        datastream_metadata.change_type AS change_type,
        datastream_metadata.change_sequence_number
            AS change_sequence_number,
        ROW_NUMBER() OVER (
            PARTITION BY id
            ORDER BY
                datastream_metadata.change_sequence_number DESC
        ) AS rn
    FROM ${ref("int_installmentdetails")}
    ${when(incremental(), `
        WHERE datastream_metadata.change_sequence_number
            > previous_rowversion
    `)}
)

SELECT
    d.id AS installmentdetails_id,
    d.installmentid AS installment_id,
    d.purchaseorderid AS purchaseorder_id,
    d.customerid AS customer_id,
    d.promoid AS promo_id,
    d.merchantid AS merchant_id,
    d.branchid AS branch_id,
    d.sourceid AS source_id,
    d.status AS status_id,
    l.name AS status_name,
    d.months AS tenor_months,
    CAST(d.adminfees AS BIGNUMERIC) AS adminfees,
    CAST(d.downpayment AS BIGNUMERIC) AS downpayment,
    CAST(d.interestrate AS FLOAT64) AS interestrate,
    CAST(d.installmentamount AS BIGNUMERIC) AS installmentamount,
    CAST(d.monthlypaid AS BIGNUMERIC) AS monthlypaid,
    CAST(d.totalamount AS BIGNUMERIC) AS totalamount,
    d.createdby AS createdby,
    CAST(d.createddate AS DATETIME) AS createddate,
    d.lastmodifiedby AS modifiedby,
    CAST(d.lastmodifieddate AS DATETIME) AS lastmodifieddate,
    COALESCE(CAST(d.lastmodifieddate AS DATETIME),
             CAST(d.createddate AS DATETIME)) AS row_timestamp,
    d.change_sequence_number AS rowversion,
    CURRENT_DATETIME() AS etl_timestamp
FROM ranked d
LEFT JOIN ${ref("LookupInstallmentDetailsStatus")} l
    ON l.id = d.status
WHERE d.rn = 1
  AND d.change_type IN ('INSERT', 'UPDATE-INSERT')