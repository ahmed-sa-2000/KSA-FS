config {
    type: "table",
    dependencies: [
    "assert_ext_answeroption_not_empty",
    ],
    bigquery: {
        partitionBy: "DATE(ao_createddate)",
      clusterBy: ["ao_id", "ao_questionid"]
  }
}

pre_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['merchant_schema:answeroption'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['merchant_schema:answeroption'],
      TRUE
    )
}


SELECT
    id AS ao_id,
    questionid AS ao_questionid,
    optiontext AS ao_optiontext,
    optiontextar AS ao_optiontextar,
    optionvalue AS ao_optionvalue,
    displayorder AS ao_displayorder,
    createdby AS ao_createdby,
    isactive AS ao_isactive ,
    CAST(createddate AS DATETIME) AS ao_createddate,
    lastmodifiedby AS ao_lastmodifiedby,
    CAST(lastmodifieddate AS DATETIME) AS ao_lastmodifieddate

FROM ${ref("ext_answeroption")}