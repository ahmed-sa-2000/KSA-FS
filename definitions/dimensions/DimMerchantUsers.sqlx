config {
    type: "incremental",
    uniqueKey: ["mu_merchantid"],
    onSchemaChange: "EXTEND",
    dependencies: [
        "assert_DimDealersStores_not_empty"
    ],
    bigquery: {
        partitionBy: "DATE(mu_createddate)",
        clusterBy: ["mu_merchantid", "ds_storeid"]
    }
}

pre_operations {
    -- Capture the target checkpoint before processing
    DECLARE previous_rowversion STRING DEFAULT (
        ${when(
            incremental(),
            `SELECT COALESCE(MAX(rowversion), '')
             FROM ${self()}`,
            `SELECT CAST('' AS STRING)`
        )}
    );

    ---
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['merchant_schema:users'],
        FALSE
    );
}

post_operations {
    -- Delete only users whose latest event in the new delta is a delete
    ${when(incremental(), `
        DELETE FROM ${self()} AS T
        WHERE EXISTS (
            SELECT 1
            FROM (
                SELECT
                    id,
                    datastream_metadata.change_type AS change_type,
                    datastream_metadata.change_sequence_number
                        AS change_sequence_number
                FROM ${ref("int_users")}
                WHERE datastream_metadata.change_sequence_number
                    > previous_rowversion
                QUALIFY ROW_NUMBER() OVER (
                    PARTITION BY id
                    ORDER BY
                        datastream_metadata.change_sequence_number DESC
                ) = 1
            ) AS S
            WHERE S.id = T.mu_merchantid
              AND S.change_type IN ('DELETE', 'UPDATE-DELETE')
              AND S.change_sequence_number > T.rowversion
        );
    `)}

    ---
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['merchant_schema:users'],
        TRUE
    );
}

WITH ranked AS (
    SELECT
        *,
        datastream_metadata.change_type AS change_type,
        datastream_metadata.change_sequence_number
            AS change_sequence_number,
        ROW_NUMBER() OVER (
            PARTITION BY id
            ORDER BY
                datastream_metadata.change_sequence_number DESC
        ) AS rn
    FROM ${ref("int_users")}
    ${when(incremental(), `
        WHERE datastream_metadata.change_sequence_number
            > previous_rowversion
    `)}
)

SELECT
    u.id AS mu_merchantid,
    ds.ds_id AS ds_storeid,
    ds.ds_name AS ds_storename,
    u.StoreCode AS mu_storecode,
    u.UserName AS mu_username,
    u.Email AS mu_email,
    u.IsActive AS mu_isactive,
    u.IsSuperMerchant AS mu_issuper_merchant,
    u.SkipApproval AS mu_skipapproval,
    u.CreatedBy AS mu_createdby,
    u.LastModifiedBy AS mu_modifiedby,
    CAST(u.CreatedDate AS DATETIME) AS mu_createddate,
    CAST(u.LastModifiedDate AS DATETIME) AS mu_modifieddate,
    COALESCE(CAST(u.LastModifiedDate AS DATETIME),
             CAST(u.CreatedDate AS DATETIME)) AS row_timestamp,
    u.change_sequence_number AS rowversion,
    CURRENT_DATETIME() AS etl_timestamp
FROM ranked u
LEFT JOIN ${ref("DimDealersStores")} ds
    ON ds.ds_storecode = u.StoreCode
WHERE u.rn = 1
  AND u.change_type IN ('INSERT', 'UPDATE-INSERT')