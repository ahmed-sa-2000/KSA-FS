config {
    type: "table",
    /*
      uniqueKey: ["mu_merchantid"]
    */

    dependencies: [
    "assert_ext_Users_not_empty"
  ],
  
  bigquery: {
    clusterBy: ["mu_merchantid", "mu_storecode"]
  }
}

pre_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['users'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['users'],
      TRUE
    )
}


  select
    id as mu_merchantid,
    StoreCode as mu_storecode,
    UserName as mu_username,
    Email as mu_email,
    IsActive as mu_isactive,
    IsSuperMerchant as mu_issuper_merchant,
    SkipApproval as mu_skipapproval,
    CreatedBy as mu_createdby,
    LastModifiedBy as mu_modifiedby,
    CAST(CreatedDate AS DATETIME) as mu_createddate,
    CAST(LastModifiedDate AS DATETIME) as mu_modifieddate,
    COALESCE(CAST(LastModifiedDate AS DATETIME), CAST(CreatedDate AS DATETIME)) as row_timestamp,
    CURRENT_DATETIME() AS etl_timestamp

  from ${ref('ext_Users')}


/*
${when(incremental(), 
  `
  WHERE COALESCE(CAST(LastModifiedDate AS DATETIME), CAST(CreatedDate AS DATETIME)) >= (select MAX(row_timestamp) from ${self()})
  `
)}
*/