  `WHERE COALESCE(CAST(t.lastmodifieddate AS DATETIME), CAST(t.createddate AS DATETIME)) >=
        (SELECT MAX(COALESCE(pt_lastmodifieddate, pt_createddate)) FROM ${self()})`
)}
