config {
    type: "table",

    dependencies: [
    "assert_LookupInstallmentStatus_not_empty",
    "assert_LookupInstallmentSources_not_empty",
    "assert_ext_Installments_not_empty"
  ],
  bigquery: {
    partitionBy: "DATE(created_date)",
    clusterBy: ["installment_id", "status"]
  }
    /*
      // uniqueKey: ["i_id"]
    */
}


pre_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['installments'],
      FALSE )
}

post_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['installments'],
      TRUE )
}

WITH installment_stg AS (
  SELECT
    id,
    programid,
    customerid ,
    sourceid ,
    automationid ,
    neededamount ,
    approvedamount ,
    maxdbrcanexist ,
    flaterate ,
    maxmonthlyinstallmentcanpaid ,
    score ,
    maxtenormonths ,
    downpaymentpercent,
    status ,
    createdby ,
    createddate ,
    lastmodifiedby ,
    lastmodifieddate 
FROM ${ref('ext_Installments')}

),
installment_status_stg AS (
    SELECT id, name
    FROM ${ref('LookupInstallmentStatus')}
),
installment_sources_stg AS (
    SELECT id, name
    FROM ${ref('LookupInstallmentSources')}
)
SELECT 
    i.id AS installment_id,
    i.customerid AS customer_id,
    i.sourceid AS source_id,
    isg.name AS source_name,
    i.status AS status,
    ist.name AS status_name,
    i.programid AS program_id,
    i.automationid AS automation_id,
    CAST(i.neededamount AS BIGNUMERIC) AS neededamount,
    CAST(i.approvedamount AS BIGNUMERIC) AS approvedamount,
    CAST(i.maxmonthlyinstallmentcanpaid AS BIGNUMERIC) AS maxmonthly_installmentcanpaid,
    i.maxtenormonths AS maxtenormonths,
    CAST(i.downpaymentpercent AS FLOAT64) AS downpaymentpercent,
    i.score AS score,
    i.maxdbrcanexist AS maxdbrcanexist,
    CAST(i.flaterate AS FLOAT64) AS flaterate,
    i.createdby AS created_by,
    CAST(i.createddate AS DATETIME) AS created_date,
    i.lastmodifiedby AS lastmodified_by,
    CAST(i.lastmodifieddate AS DATETIME) AS lastmodified_date,
    CURRENT_DATETIME() AS etl_timestamp
FROM installment_stg i
    LEFT JOIN installment_status_stg ist ON ist.id = i.status
    LEFT JOIN installment_sources_stg isg  ON isg.id = i.sourceid


/*
${when(incremental(),
  `WHERE COALESCE(CAST(i.lastmodifieddate AS DATETIME), CAST(i.createddate AS DATETIME)) >=
        (SELECT MAX(COALESCE(i_lastmodifieddate, i_createddate)) FROM ${self()})`
)}
*/