config {
    type: "table",

    dependencies: [
    "assert_LookupInstallmentStatus_not_empty",
    "assert_LookupInstallmentSources_not_empty",
    "assert_ext_Installments_not_empty"
  ]
    /*
      // uniqueKey: ["i_id"]
    */
}


WITH installment_stg AS (
    SELECT
    id,
    programid,
    customerid ,
    sourceid ,
    automationid ,
    neededamount ,
    approvedamount ,
    maxdbrcanexist ,
    flaterate ,
    maxmonthlyinstallmentcanpaid ,
    score ,
    maxtenormonths ,
    downpaymentpercent,
    status ,
    createdby ,
    createddate ,
    lastmodifiedby ,
    lastmodifieddate 
FROM ${ref('ext_Installments')}

),
installment_status_stg AS (
    SELECT id, name
    FROM ${ref('LookupInstallmentStatus')}
),
installment_sources_stg AS (
    SELECT id, name
    FROM ${ref('LookupInstallmentSources')}
)
SELECT 
    i.id AS i_id,
    i.programid AS i_programid,
    i.customerid AS i_customerid,
    i.sourceid AS i_sourceid,
    isg.name AS i_sourcename,
    i.automationid AS i_automationid,
    CAST(i.neededamount AS BIGNUMERIC) AS i_neededamount,
    CAST(i.approvedamount AS BIGNUMERIC) AS i_approvedamount,
    i.maxdbrcanexist AS i_maxdbrcanexist,
    CAST(i.flaterate AS FLOAT64) AS i_flaterate,
    CAST(i.maxmonthlyinstallmentcanpaid AS BIGNUMERIC) AS i_maxmonthly_installmentcanpaid,
    i.score AS i_score,
    i.maxtenormonths AS i_maxtenormonths,
    CAST(i.downpaymentpercent AS FLOAT64) AS i_downpaymentpercent,
    i.status AS i_status,
    ist.name AS i_statusname,
    i.createdby AS i_createdby,
    CAST(i.createddate AS DATETIME) AS i_createddate,
    i.lastmodifiedby AS i_lastmodifiedby,
    CAST(i.lastmodifieddate AS DATETIME) AS i_lastmodifieddate,
    CURRENT_DATETIME() AS etl_timestamp
FROM installment_stg i
    LEFT JOIN installment_status_stg ist ON ist.id = i.status
    LEFT JOIN installment_sources_stg isg  ON isg.id = i.sourceid



pre_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['Installments'],
      FALSE )
}

post_operations {
  CALL
    `rifd-datascience-sa.aman_test.update_watermark_with_retry`( ['Installments'],
      TRUE )
}

