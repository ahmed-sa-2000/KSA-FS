config {
    type: "incremental",
    uniqueKey: ["installment_id"],
    onSchemaChange: "EXTEND",
    dependencies: [
        "assert_LookupInstallmentStatus_not_empty",
        "assert_LookupInstallmentSources_not_empty"
    ],
    bigquery: {
        partitionBy: "DATE(created_date)",
        clusterBy: ["installment_id", "status"]
    }
}

pre_operations {
    -- Capture the target checkpoint before processing
    DECLARE previous_rowversion STRING DEFAULT (
        ${when(
            incremental(),
            `SELECT COALESCE(MAX(rowversion), '')
             FROM ${self()}`,
            `SELECT CAST('' AS STRING)`
        )}
    );

    ---
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['loan_schema:installments'],
        FALSE
    );
}

post_operations {
    -- Delete only installments whose latest event in the new delta is a delete
    ${when(incremental(), `
        DELETE FROM ${self()} AS T
        WHERE EXISTS (
            SELECT 1
            FROM (
                SELECT
                    id,
                    datastream_metadata.change_type AS change_type,
                    datastream_metadata.change_sequence_number
                        AS change_sequence_number
                FROM ${ref("int_installments")}
                WHERE datastream_metadata.change_sequence_number
                    > previous_rowversion
                QUALIFY ROW_NUMBER() OVER (
                    PARTITION BY id
                    ORDER BY
                        datastream_metadata.change_sequence_number DESC
                ) = 1
            ) AS S
            WHERE S.id = T.installment_id
              AND S.change_type IN ('DELETE', 'UPDATE-DELETE')
              AND S.change_sequence_number > T.rowversion
        );
    `)}

    ---
    CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
        ['loan_schema:installments'],
        TRUE
    );
}

WITH installment_stg AS (
    SELECT
        *,
        datastream_metadata.change_type AS change_type,
        datastream_metadata.change_sequence_number
            AS change_sequence_number,
        ROW_NUMBER() OVER (
            PARTITION BY id
            ORDER BY
                datastream_metadata.change_sequence_number DESC
        ) AS rn
    FROM ${ref("int_installments")}
    ${when(incremental(), `
        WHERE datastream_metadata.change_sequence_number
            > previous_rowversion
    `)}
),
installment_status_stg AS (
    SELECT id, name
    FROM ${ref("LookupInstallmentStatus")}
),
installment_sources_stg AS (
    SELECT id, name
    FROM ${ref("LookupInstallmentSources")}
)

SELECT
    i.id AS installment_id,
    i.customerid AS customer_id,
    i.sourceid AS source_id,
    isg.name AS source_name,
    i.status AS status,
    ist.name AS status_name,
    i.programid AS program_id,
    i.automationid AS automation_id,
    CAST(i.neededamount AS BIGNUMERIC) AS neededamount,
    CAST(i.approvedamount AS BIGNUMERIC) AS approvedamount,
    CAST(i.maxmonthlyinstallmentcanpaid AS BIGNUMERIC) AS maxmonthly_installmentcanpaid,
    i.maxtenormonths AS maxtenormonths,
    CAST(i.downpaymentpercent AS FLOAT64) AS downpaymentpercent,
    i.score AS score,
    i.maxdbrcanexist AS maxdbrcanexist,
    CAST(i.flaterate AS FLOAT64) AS flaterate,
    i.createdby AS created_by,
    CAST(i.createddate AS DATETIME) AS created_date,
    i.lastmodifiedby AS lastmodified_by,
    CAST(i.lastmodifieddate AS DATETIME) AS lastmodified_date,
    i.change_sequence_number AS rowversion,
    CURRENT_DATETIME() AS etl_timestamp
FROM installment_stg i
LEFT JOIN installment_status_stg ist
    ON ist.id = i.status
LEFT JOIN installment_sources_stg isg
    ON isg.id = i.sourceid
WHERE i.rn = 1
  AND i.change_type IN ('INSERT', 'UPDATE-INSERT')