config {
    type: "table",

    dependencies: [
        'assert_ext_AdminRequests_not_empty',
        'assert_LookupRequestStatuses_not_empty',
    ]
    ,
    bigquery: {
        partitionBy:"Date(mr_createddate)"
    }

    /*
      uniqueKey: ["app_id"]
    */
}

pre_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['AdminRequests', 'RequestStatuses'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['AdminRequests', 'RequestStatuses'],
      TRUE
    )
}

WITH admin_requests_cte as (
  SELECT 
      Id as ar_requestid,
      RequestType as ar_requesttype,
      StatusId as ar_request_statusid,
      RejectionReason as ar_rejectionreason,
      Notes as ar_notes,
      CreatedBy as ar_createdby,
      LastModifiedBy as ar_modifiedby,
      CreatedDate as ar_createddate,
      LastModifiedDate as ar_modifieddate
  FROM ${ref('ext_AdminRequests')}
),

request_status_cte as (
  SELECT 
      rs_request_statuesid,
      rs_requestname as rs_request_statusname
  FROM ${ref('LookupRequestStatuses')}
)
SELECT
  arc.ar_requestid,
  rsc.rs_request_statusname as ar_request_statusname,
  arc.ar_rejectionreason,
  arc.ar_notes,
  arc.ar_createdby,
  arc.ar_modifiedby,
  arc.ar_createddate,
  arc.ar_modifieddate,
  CURRENT_DATETIME() AS etl_timestamp
FROM admin_requests_cte arc
    LEFT JOIN request_status_cte rsc ON rsc.rs_request_statuesid = arc.ar_request_statusid


/*
${when(incremental(), 
  `
  WHERE COALESCE(arc.ar_modifieddate, arc.ar_createddate) >= (select MAX(GREATEST(ar_createddate, ar_modifieddate)) from ${self()})
  `
)}
*/




