config {
    type: "table",

    dependencies: [
    "assert_ext_DealersStores_not_empty",
    "assert_ext_Dealers_not_empty"
  ],
    bigquery: {
        clusterBy: ["ds_id", "ds_storecode"]
    }
    /*
      // uniqueKey: ["ds_id"]
    */
}

pre_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['dealersstores', 'dealers'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['dealersstores', 'dealers'],
      TRUE
    )
}

WITH
dealers AS (
  SELECT
    id AS d_dealerid,
    Name AS d_name,
    IsActive AS d_active,
    ReturnPolicy AS d_returnpolicy,
    InterestRate AS d_interestrate,
    Refundable AS d_refundable,
    Phone AS d_phone,
    Visible AS d_visible
  FROM
    ${ref("ext_Dealers")} ),
dealer_stores AS (
  SELECT
    id AS ds_id,
    StoreCode AS ds_storecode,
    Name AS ds_name,
    DealerId AS dealerid,
    Active AS ds_active,
    RecapPolicy AS ds_returnpolicy,
    InterestRate AS ds_interestrate,
    District AS ds_district,
    Country AS ds_country,
    CreatedBy AS ds_createdby,
    CreatedDate AS ds_createddate,
    LastModifiedBy AS ds_modifiedby,
    LastModifiedDate AS ds_modifieddate
  FROM
    ${ref("ext_DealersStores")} ),
stg_cte as (
  SELECT
    ds.ds_id,
    ds.ds_storecode,
    d.dealer_id AS ds_dealerid,
    -- Dealer Fields
    d.d_name,
    d.d_active,
    d.d_returnpolicy,
    d.d_interestrate,
    d.d_refundable,
    d.d_phone,
    d.d_visible,
    -- Store Fields
    ds.ds_name,
    ds.ds_active,
    ds.ds_returnpolicy,
    ds.ds_interestrate,
    ds.ds_district,
    ds.ds_country,
    ds.ds_createdby,
    ds.ds_modifiedby,
    ds.ds_createddate,
    ds.ds_modifieddate,
    COALESCE(ds.ds_modifieddate, ds.ds_createddate) as row_timestamp
  FROM
    dealer_stores ds
  LEFT JOIN
    dealers d
  ON
    d.dealer_id = ds.dealer_id
)
SELECT
  s.*,
  CURRENT_DATETIME() AS etl_timestamp
FROM stg_cte s

/*
${when(incremental(), 
  `
  WHERE COALESCE(s.ds_modifieddate, s.ds_createddate) >= (select MAX(row_timestamp) from ${self()})
  `
)}
*/


