config {
    type: "table",

    dependencies: [
    "assert_ext_DealersStores_not_empty",
    "assert_ext_Dealers_not_empty"
  ],
    bigquery: {
        partitionBy:"Date(ds_createddate)"
    }
    /*
      // uniqueKey: ["ds_id"]
    */
}

pre_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['DealersStores', 'Dealers'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['DealersStores', 'Dealers'],
      TRUE
    )
}

WITH
dealers AS (
  SELECT
    id AS d_dealerid,
    Name AS d_name,
    IsActive AS d_active,
    ReturnPolicy AS d_return_policy,
    InterestRate AS d_interest_rate,
    Refundable AS d_refundable,
    Phone AS d_phone,
    Visible AS d_visible
  FROM
    ${ref("ext_Dealers")} ),
dealer_stores AS (
  SELECT
    id AS ds_id,
    StoreCode AS ds_store_code,
    Name AS ds_name,
    DealerId AS dealer_id,
    Active AS ds_active,
    RecapPolicy AS ds_return_policy,
    InterestRate AS ds_interest_rate,
    District AS ds_district,
    Country AS ds_country,
    CreatedBy AS ds_createdby,
    CreatedDate AS ds_createddate,
    LastModifiedBy AS ds_modifiedby,
    LastModifiedDate AS ds_modifieddate
  FROM
    ${ref("ext_DealersStores")} ),
stg_cte as (
  SELECT
    ds.ds_id,
    ds.ds_store_code,
    d.dealer_id AS ds_dealer_id,
    -- Dealer Fields
    d.d_name,
    d.d_active,
    d.d_return_policy,
    d.d_interest_rate,
    d.d_refundable,
    d.d_phone,
    d.d_visible,
    -- Store Fields
    ds.ds_name,
    ds.ds_active,
    ds.ds_return_policy,
    ds.ds_interest_rate,
    ds.ds_district,
    ds.ds_country,
    ds.ds_createdby,
    ds.ds_modifiedby,
    ds.ds_createddate,
    ds.ds_modifieddate
  FROM
    dealer_stores ds
  LEFT JOIN
    dealers d
  ON
    d.dealer_id = ds.dealer_id
)
SELECT
  s.*,
  MD5(
    TO_JSON_STRING(
      (SELECT p FROM (SELECT s.* EXCEPT(ds_id)) AS p)
    )
  ) as hashkey,
  CURRENT_DATETIME() AS etl_timestamp
FROM stg_cte s

/*
${when(incremental(), 
  `
  WHERE COALESCE(s.ds_modifieddate, s.ds_createddate) >= (select MAX(GREATEST(ds_createddate, ds_modifieddate)) from ${self()})
  `
)}
*/


