config {
    type: "table",
    dependencies: [
      "assert_ext_roles_not_empty",
    ],
    bigquery: {
      clusterBy: ["r_roleid", "r_rolename"]
  }
}

pre_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['merchant_schema:roles'],
      FALSE
    )
}

post_operations {
  CALL `rifd-datascience-sa.aman_test.update_watermark_with_retry`(
      ['merchant_schema:roles'],
      TRUE
    )
}

select 
  id as r_roleid,
  Name as r_rolename,
  CreatedBy as r_createdby,
  LastModifiedBy as r_modifiedby,
  CAST(CreatedDate AS DATETIME) as r_createddate,
  CAST(LastModifiedDate AS DATETIME) as r_modifieddate,
  CURRENT_DATETIME() AS etl_timestamp
from ${ref('ext_roles')}